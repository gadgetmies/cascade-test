{
  "name": "cascade-test",
  "version": "0.4.0",
  "description": "A test framework where context cascades through your test hierarchy. Built with TypeScript for type safety and plain JavaScript objects with automatic context passing.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "cascade-test": "./dist/bin/run-tests.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "tsx src/bin/run-tests.ts src/test/integration",
    "test:dev": "tsx src/bin/run-tests.ts src/test/integration",
    "test:fixtures": "tsx src/bin/run-tests.ts src/test/integration",
    "test:reporters": "tsx src/bin/run-tests.ts --regex='reporter-' src/test/integration",
    "test:examples": "tsx src/bin/run-tests.ts src/test/examples",
    "test:examples-mocha-json": "tsx src/bin/run-tests.ts --reporter=mocha-json --output=mocha-results.json src/test/examples",
    "test:examples-junit": "tsx src/bin/run-tests.ts --reporter=junit --output=test-results.xml src/test/examples",
    "test:coverage": "tsx src/bin/run-tests.ts src/test/examples --coverage",
    "test:coverage:html": "tsx src/bin/run-tests.ts src/test/examples --coverage --coverage-reporter html",
    "test:coverage:lcov": "tsx src/bin/run-tests.ts src/test/examples --coverage --coverage-reporter lcov",
    "test:coverage:ci": "tsx src/bin/run-tests.ts src/test/integration --coverage --coverage-reporter text --coverage-reporter lcov",
    "test:mocha": "mocha",
    "test:mocha-json": "mocha --reporter json 2>/dev/null > mocha-results.json || true",
    "test:jest": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:jest-junit": "NODE_OPTIONS=--experimental-vm-modules jest"
  },
  "keywords": [
    "test",
    "testing",
    "framework",
    "async",
    "cascade",
    "context",
    "hierarchy"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@types/lodash": "^4.17.20",
    "bluebird": "^3.7.2",
    "c8": "^10.1.2",
    "colors": "^1.4.0",
    "jest-diff": "^30.2.0",
    "lodash": "^4.17.21",
    "minimatch": "^9.0.9",
    "partial.lenses": "^14.17.0",
    "ramda": "^0.29.1",
    "tsx": "^4.21.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/chai": "^5.2.2",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "@types/ramda": "^0.29.0",
    "@types/sinon": "^17.0.4",
    "@types/yargs": "^17.0.0",
    "chai": "^6.2.0",
    "jest": "^30.2.0",
    "jest-junit": "^16.0.0",
    "mocha": "^11.7.4",
    "sinon": "^21.0.0",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=12.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gadgetmies/cascade-test.git"
  },
  "bugs": {
    "url": "https://github.com/gadgetmies/cascade-test/issues"
  },
  "homepage": "https://github.com/gadgetmies/cascade-test#readme"
}
